<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kirari</AssemblyName>
    <ApplicationIcon>kirari.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DPI awareness is declared in app.manifest (PerMonitorV2) for the WPF host; that sets
         process-wide awareness which WinForms also honours, so suppress its API-preference notice. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.1" />
    <!-- Fully open-source OCR stack: Apache-2.0 code + PP-OCR models, MIT onnxruntime/SkiaSharp. -->
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Chinese PP-OCRv5 recognition model + dictionary (Apache-2.0, from RapidAI/RapidOCR). -->
    <Content Include="models\v5\ch_PP-OCRv5_rec_mobile.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\v5\ppocrv5_dict.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
